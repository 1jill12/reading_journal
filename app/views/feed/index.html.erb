<div class="max-w-2xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-bold theme-text">Feed</h1>
    <%= link_to "Find People", users_path,
        class: "text-sm font-medium px-4 py-2 rounded-lg transition hover:opacity-80",
        style: "background-color: var(--theme-accent); color: var(--theme-accent-text);" %>
  </div>

  <% if current_user.following.none? %>
    <div class="theme-bg-card rounded-xl p-10 border theme-border text-center">
      <p class="text-4xl mb-4">👥</p>
      <p class="theme-text font-semibold mb-2">Your feed is empty</p>
      <p class="theme-text-secondary text-sm mb-6">Follow other readers to see what they're reading, finishing, and reflecting on.</p>
      <%= link_to "Find People to Follow →", users_path,
          class: "text-sm font-medium theme-accent-color hover:opacity-70 transition" %>
    </div>
  <% elsif @activities.empty? %>
    <div class="theme-bg-card rounded-xl p-10 border theme-border text-center">
      <p class="theme-text-secondary">The people you follow haven't had any activity yet.</p>
    </div>
  <% else %>
    <div class="theme-bg-card rounded-xl shadow-lg border theme-border px-6">
      <% @activities.each do |activity| %>
        <%= render "shared/activity_card", activity: activity %>
      <% end %>
    </div>
  <% end %>
</div>
