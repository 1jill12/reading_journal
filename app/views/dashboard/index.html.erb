<div class="max-w-7xl mx-auto">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold theme-text">My Reading Dashboard</h1>
    <%= link_to "View All Books", books_path,
        class: "font-medium py-3 px-6 rounded-lg transition duration-200 hover:opacity-80",
        style: "background-color: var(--theme-accent); color: var(--theme-accent-text);" %>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="theme-bg-card rounded-lg shadow-lg p-6 border theme-border">
      <h3 class="text-sm font-medium theme-text-muted mb-2">Total Books</h3>
      <p class="text-4xl font-bold theme-text"><%= @total_books %></p>
    </div>
    <div class="theme-bg-card rounded-lg shadow-lg p-6 border theme-border">
      <h3 class="text-sm font-medium theme-text-secondary mb-2">Finished</h3>
      <p class="text-4xl font-bold theme-stat-finished"><%= @finished_books %></p>
    </div>
    <div class="theme-bg-card rounded-lg shadow-lg p-6 border theme-border">
      <h3 class="text-sm font-medium theme-text-secondary mb-2">Currently Reading</h3>
      <p class="text-4xl font-bold theme-stat-reading"><%= @currently_reading %></p>
    </div>
    <div class="theme-bg-card rounded-lg shadow-lg p-6 border theme-border">
      <h3 class="text-sm font-medium theme-text-secondary mb-2">Want to Read</h3>
      <p class="text-4xl font-bold theme-stat-want"><%= @want_to_read %></p>
    </div>
  </div>

  <!-- Additional Stats -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="theme-bg-card rounded-lg shadow-lg p-6 border theme-border">
      <h3 class="text-lg font-semibold theme-text mb-2">Total Pages Read</h3>
      <p class="text-3xl font-bold theme-text">
        <%= @total_pages.to_i.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse %>
      </p>
    </div>
    <div class="theme-bg-card rounded-lg shadow-lg p-6 border theme-border">
      <h3 class="text-lg font-semibold theme-text mb-2">Top Genre</h3>
      <p class="text-2xl font-bold theme-text">
        <%= @top_genre || %(<span class="theme-text-muted text-base font-normal">None yet</span>).html_safe %>
      </p>
    </div>
    <div class="theme-bg-card rounded-lg shadow-lg p-6 border theme-border">
      <h3 class="text-lg font-semibold theme-text mb-2">Average Rating</h3>
      <p class="text-3xl font-bold theme-star">
        <% if @average_rating %>
          <%= "★" * @average_rating.to_i %><span class="theme-text-muted"><%= "☆" * (5 - @average_rating.to_i) %></span>
          <span class="theme-text-secondary text-lg ml-1"><%= @average_rating %></span>
        <% else %>
          <span class="theme-text-muted text-lg font-normal">No ratings yet</span>
        <% end %>
      </p>
    </div>
  </div>

  <!-- Active Goals -->
  <div class="theme-bg-card rounded-lg shadow-lg p-6 mb-8 border theme-border">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-2xl font-bold theme-text">Reading Goals</h2>
      <%= link_to "Manage Goals", reading_goals_path,
          class: "text-sm hover:opacity-70 transition",
          style: "color: var(--theme-accent);" %>
    </div>
    <% if @active_goals.any? %>
      <div class="space-y-4">
        <% @active_goals.each do |goal| %>
          <div>
            <div class="flex justify-between items-baseline mb-1">
              <span class="text-sm font-medium theme-text"><%= goal.display_title %></span>
              <span class="text-sm theme-text-muted"><%= goal.display_progress %> &middot; <%= goal.percentage %>%</span>
            </div>
            <div class="w-full rounded-full h-3" style="background-color: var(--theme-border);">
              <div class="h-3 rounded-full transition-all duration-500"
                   style="width: <%= goal.percentage %>%; background-color: var(--theme-accent);"></div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="theme-text-secondary mb-4">Set a reading goal to track your progress!</p>
      <%= link_to "Set Reading Goal", reading_goals_path,
          class: "px-4 py-2 rounded-lg transition text-sm font-medium",
          style: "background-color: var(--theme-accent); color: var(--theme-accent-text);" %>
    <% end %>
  </div>

  <!-- Recent Books -->
  <div class="theme-bg-card rounded-lg shadow-lg p-6 border theme-border">
    <h2 class="text-2xl font-bold theme-text mb-6">Recent Books</h2>
    <% if @recent_books.any? %>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        <% @recent_books.each do |book| %>
          <%= link_to book, class: "block group" do %>
            <% if book.cover_url.present? %>
              <%= image_tag book.cover_url,
                  class: "w-full h-48 object-cover rounded-lg shadow-md group-hover:shadow-xl transition",
                  alt: book.title %>
            <% else %>
              <div class="w-full h-48 rounded-lg flex items-center justify-center shadow-md"
                   style="background-color: var(--theme-border);">
                <span class="theme-text-muted text-sm text-center px-2"><%= book.title %></span>
              </div>
            <% end %>
            <p class="text-sm theme-text-secondary mt-2 truncate"><%= book.title %></p>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="theme-text-secondary">
        No books yet.
        <%= link_to "Add your first book!", new_book_path, class: "theme-accent-color hover:opacity-70 transition" %>
      </p>
    <% end %>
  </div>
</div>
