<div class="max-w-2xl mx-auto space-y-6">
  <h1 class="text-3xl font-bold theme-text">Account Settings</h1>

  <% if notice %>
    <p class="rounded-lg px-4 py-3 text-sm border theme-border theme-text-secondary"
       style="background-color: var(--theme-bg-card);">
      <%= notice %>
    </p>
  <% end %>

  <!-- ── Profile ──────────────────────────────────────────────── -->
  <div class="theme-bg-card rounded-xl shadow-lg p-6 border theme-border">
    <h2 class="text-lg font-bold theme-text mb-5">Profile</h2>

    <%= form_with url: settings_path, method: :patch do |f| %>
      <%= hidden_field_tag :section, "profile" %>

      <% if current_user.errors[:username].any? %>
        <div class="rounded-lg px-3 py-2 mb-4 text-sm border theme-border"
             style="background-color: var(--theme-bg); color: var(--theme-stat-finished);">
          <% current_user.errors[:username].each do |msg| %>
            <p>Username <%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <div class="mb-4">
        <%= label_tag :username, "Username", class: "block text-sm font-medium theme-text-secondary mb-2" %>
        <%= text_field_tag "user[username]", current_user.username,
            placeholder: "e.g. bookworm_jill",
            class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
            style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);#{current_user.errors[:username].any? ? ' border-color: #991111;' : ''}" %>
        <p class="text-xs theme-text-muted mt-1">Lowercase letters, numbers, underscores only.</p>
      </div>

      <!-- Private profile toggle -->
      <div class="flex items-center justify-between py-4 border-t theme-border">
        <div>
          <p class="text-sm font-medium theme-text">Private Profile</p>
          <p class="text-xs theme-text-muted mt-0.5">Only your followers can see your books and activity.</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <%= check_box_tag "user[private_profile]", "1", current_user.private_profile?,
              class: "sr-only peer",
              id: "private_profile_toggle" %>
          <div class="w-11 h-6 rounded-full peer transition-all duration-200 peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all"
               style="background-color: var(--theme-border);"
               id="toggle_track"></div>
        </label>
      </div>

      <div class="mt-5">
        <%= submit_tag "Save Profile",
            class: "px-6 py-2 rounded-lg text-sm font-medium cursor-pointer transition hover:opacity-80",
            style: "background-color: var(--theme-accent); color: var(--theme-accent-text);" %>
      </div>
    <% end %>
  </div>

  <!-- ── Account (email / password) ───────────────────────────── -->
  <div class="theme-bg-card rounded-xl shadow-lg p-6 border theme-border">
    <h2 class="text-lg font-bold theme-text mb-1">Account</h2>
    <p class="text-xs theme-text-muted mb-5">Your current email: <span class="theme-text-secondary"><%= current_user.email %></span></p>

    <%= form_with url: settings_path, method: :patch do |f| %>
      <%= hidden_field_tag :section, "account" %>

      <% if current_user.errors.any? && params[:section] == 'account' %>
        <div class="rounded-lg px-4 py-3 mb-4 text-sm border theme-border"
             style="background-color: var(--theme-bg); color: var(--theme-stat-finished);">
          <% current_user.errors.full_messages.each do |msg| %>
            <p><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <div class="mb-4">
        <%= label_tag "user_email", "New Email", class: "block text-sm font-medium theme-text-secondary mb-2" %>
        <%= email_field_tag "user[email]", nil, placeholder: current_user.email,
            class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
            style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
      </div>

      <div class="mb-4">
        <%= label_tag "user_password", "New Password", class: "block text-sm font-medium theme-text-secondary mb-2" %>
        <%= password_field_tag "user[password]", nil, placeholder: "Leave blank to keep current",
            class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
            style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
      </div>

      <div class="mb-5">
        <%= label_tag "user_password_confirmation", "Confirm New Password", class: "block text-sm font-medium theme-text-secondary mb-2" %>
        <%= password_field_tag "user[password_confirmation]", nil,
            class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
            style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
      </div>

      <div class="mb-5 pt-4 border-t theme-border">
        <%= label_tag "user_current_password", "Current Password", class: "block text-sm font-medium theme-text-secondary mb-2" %>
        <p class="text-xs theme-text-muted mb-2">Required to change email or password.</p>
        <%= password_field_tag "user[current_password]", nil,
            class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
            style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
      </div>

      <%= submit_tag "Update Account",
          class: "px-6 py-2 rounded-lg text-sm font-medium cursor-pointer transition hover:opacity-80",
          style: "background-color: var(--theme-accent); color: var(--theme-accent-text);" %>
    <% end %>
  </div>

  <!-- ── Danger zone ───────────────────────────────────────────── -->
  <div class="rounded-xl p-6 border" style="border-color: rgba(180,20,20,0.3); background-color: rgba(180,20,20,0.05);">
    <h2 class="text-lg font-bold theme-text mb-1">Delete Account</h2>
    <p class="text-sm theme-text-muted mb-4">Permanently delete your account and all your data. This cannot be undone.</p>

    <%# Trigger button %>
    <button onclick="document.getElementById('delete-confirm').classList.remove('hidden'); this.classList.add('hidden');"
            class="px-6 py-2 rounded-lg text-sm font-medium cursor-pointer transition hover:opacity-80"
            style="background-color: #991111; color: #fff; border: none;">
      Delete Account
    </button>

    <%# Confirmation panel %>
    <div id="delete-confirm" class="hidden rounded-xl p-6 border mt-2" style="border-color: rgba(180,20,20,0.4); background-color: rgba(180,20,20,0.08);">
      <p class="text-lg font-bold theme-text mb-1">We're so sorry to see you go 💔</p>
      <p class="text-sm theme-text-muted mb-5">Once you confirm, your account and all your books, goals, and progress will be permanently deleted.</p>
      <div class="flex gap-3">
        <%= button_to "Yes, delete my account", user_registration_path, method: :delete,
            class: "px-5 py-2 rounded-lg text-sm font-medium cursor-pointer transition hover:opacity-80",
            style: "background-color: #991111; color: #fff; border: none;",
            data: { turbo: false } %>
        <button onclick="document.getElementById('delete-confirm').classList.add('hidden'); document.querySelector('[onclick*=delete-confirm]').classList.remove('hidden');"
                class="px-5 py-2 rounded-lg text-sm font-medium cursor-pointer transition hover:opacity-80 theme-text"
                style="background-color: var(--theme-bg-card); border: 1px solid var(--theme-border);">
          Cancel
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // Sync toggle track colour with checked state
  const toggle = document.getElementById('private_profile_toggle');
  const track  = document.getElementById('toggle_track');
  function syncTrack() {
    track.style.backgroundColor = toggle.checked ? 'var(--theme-accent)' : 'var(--theme-border)';
  }
  if (toggle) { syncTrack(); toggle.addEventListener('change', syncTrack); }
</script>
