<div class="max-w-lg mx-auto">
  <div class="mb-4">
    <%= link_to "← Back to #{@book.title}", @book, class: "theme-text-muted hover:opacity-70 transition text-sm" %>
  </div>

  <div class="theme-bg-card rounded-2xl shadow-xl border theme-border p-8">
    <h1 class="text-xl font-bold theme-text mb-6">Edit Your Review</h1>

    <%= form_with(model: [@book, @review], url: book_review_path(@book), method: :patch) do |form| %>
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :rating, 'Your rating (1–5)', class: "block text-sm theme-text-muted mb-1" %>
            <%= form.number_field :rating, min: 1, max: 5, step: 0.5,
                class: "w-full px-3 py-2 rounded-lg border theme-border outline-none",
                style: "background-color: var(--theme-input-bg); color: var(--theme-text-primary);" %>
          </div>
          <div>
            <%= form.label :spice_level, 'Spice level (1–5)', class: "block text-sm theme-text-muted mb-1" %>
            <%= form.number_field :spice_level, min: 1, max: 5,
                class: "w-full px-3 py-2 rounded-lg border theme-border outline-none",
                style: "background-color: var(--theme-input-bg); color: var(--theme-text-primary);" %>
          </div>
        </div>

        <div>
          <%= form.label :review_text, 'Your recap', class: "block text-sm theme-text-muted mb-1" %>
          <%= form.text_area :review_text, rows: 6,
              class: "w-full px-3 py-2 rounded-lg border theme-border outline-none resize-none",
              style: "background-color: var(--theme-input-bg); color: var(--theme-text-primary);" %>
        </div>

        <%= form.submit 'Update Review',
            class: "w-full py-3 font-medium cursor-pointer transition hover:opacity-80 rounded-lg",
            style: "background-color: var(--theme-accent); color: var(--theme-accent-text); border: none;" %>
      </div>
    <% end %>
  </div>
</div>
