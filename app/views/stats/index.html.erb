<%= content_for :head do %>
  <%= javascript_import_module_tag "chart.js" %>
<% end %>

<div class="max-w-5xl mx-auto space-y-8">
  <h1 class="text-4xl font-bold theme-text">Reading Stats</h1>

  <!-- ── Yearly Challenge ──────────────────────────────────────── -->
  <section class="theme-bg-card rounded-xl shadow-lg p-6 border theme-border">
    <h2 class="text-xl font-bold theme-text mb-4"><%= @year %> Reading Challenge</h2>
    <% if @yearly_goal&.positive? %>
      <% pct = [(@books_this_year.to_f / @yearly_goal * 100).round, 100].min %>
      <div class="flex items-end gap-4 mb-3">
        <span class="text-5xl font-black theme-text"><%= @books_this_year %></span>
        <span class="theme-text-muted text-lg mb-1">/ <%= @yearly_goal %> books</span>
        <span class="theme-text-secondary text-lg mb-1 ml-auto"><%= pct %>%</span>
      </div>
      <div class="w-full rounded-full h-4" style="background-color: var(--theme-border);">
        <div class="theme-progress-bar h-4 rounded-full transition-all duration-700"
             style="width: <%= pct %>%;"></div>
      </div>
      <p class="theme-text-muted text-sm mt-2">
        <% remaining = [@yearly_goal - @books_this_year, 0].max %>
        <% if remaining == 0 %>
          🎉 Goal complete! You read <%= @books_this_year %> books this year.
        <% else %>
          <%= remaining %> more book<%= remaining == 1 ? '' : 's' %> to hit your goal.
        <% end %>
      </p>
    <% else %>
      <p class="theme-text-secondary mb-3">You've read <span class="font-bold theme-text"><%= @books_this_year %></span> books and <span class="font-bold theme-text"><%= number_with_delimiter(@pages_this_year) %></span> pages this year.</p>
      <%= link_to "Set a yearly goal →", edit_user_registration_path, class: "theme-accent-color text-sm hover:opacity-70 transition" %>
    <% end %>
  </section>

  <!-- ── Streak + Totals ───────────────────────────────────────── -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <% [
      ["🔥 Current Streak", "#{@current_streak} day#{ @current_streak == 1 ? '' : 's' }"],
      ["⚡ Longest Streak",  "#{@longest_streak} day#{ @longest_streak == 1 ? '' : 's' }"],
      ["📚 Total Finished",  @total_finished],
      ["📄 Total Pages",     number_with_delimiter(@total_pages)]
    ].each do |label, value| %>
      <div class="theme-bg-card rounded-xl shadow p-5 border theme-border text-center">
        <p class="text-xs theme-text-muted mb-1"><%= label %></p>
        <p class="text-2xl font-black theme-text"><%= value %></p>
      </div>
    <% end %>
  </div>

  <!-- ── Charts ────────────────────────────────────────────────── -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="theme-bg-card rounded-xl shadow-lg p-6 border theme-border">
      <h2 class="text-lg font-bold theme-text mb-4">Books Finished (12 months)</h2>
      <canvas id="booksChart" height="220"></canvas>
    </div>
    <div class="theme-bg-card rounded-xl shadow-lg p-6 border theme-border">
      <h2 class="text-lg font-bold theme-text mb-4">Pages Read (12 months)</h2>
      <canvas id="pagesChart" height="220"></canvas>
    </div>
  </div>

  <!-- ── Reading Speed + ETAs ──────────────────────────────────── -->
  <% if @avg_pages_per_day %>
    <section class="theme-bg-card rounded-xl shadow-lg p-6 border theme-border">
      <h2 class="text-xl font-bold theme-text mb-4">Reading Speed</h2>
      <div class="grid grid-cols-2 gap-6 mb-6">
        <div>
          <p class="text-xs theme-text-muted mb-1">Avg pages per day</p>
          <p class="text-3xl font-black theme-text"><%= @avg_pages_per_day %></p>
        </div>
        <div>
          <p class="text-xs theme-text-muted mb-1">Avg days per book</p>
          <p class="text-3xl font-black theme-text"><%= @avg_days_per_book %></p>
        </div>
      </div>

      <% if @current_reads_with_eta.any? %>
        <h3 class="text-sm font-semibold theme-text-secondary mb-3">Estimated finish dates</h3>
        <div class="space-y-3">
          <% @current_reads_with_eta.each do |item| %>
            <div class="flex items-center gap-4">
              <% if item[:book].cover_url.present? %>
                <%= image_tag item[:book].cover_url, class: "w-8 h-12 object-cover rounded shadow-sm flex-shrink-0", alt: item[:book].title %>
              <% end %>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium theme-text truncate"><%= item[:book].title %></p>
                <div class="w-full rounded-full h-1.5 mt-1" style="background-color: var(--theme-border);">
                  <div class="theme-progress-bar h-1.5 rounded-full" style="width: <%= item[:percent] %>%;"></div>
                </div>
              </div>
              <div class="text-right flex-shrink-0">
                <p class="text-xs font-semibold theme-accent-color"><%= item[:eta].strftime('%b %-d') %></p>
                <p class="text-xs theme-text-muted">~<%= item[:percent] %>% done</p>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <!-- ── Breakdowns ────────────────────────────────────────────── -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

    <!-- Top Authors -->
    <div class="theme-bg-card rounded-xl shadow-lg p-6 border theme-border">
      <h2 class="text-lg font-bold theme-text mb-4">Top Authors</h2>
      <% if @top_authors.any? %>
        <div class="space-y-3">
          <% @top_authors.each do |author, count| %>
            <div class="flex justify-between items-center">
              <span class="text-sm theme-text truncate pr-2"><%= author %></span>
              <span class="text-sm font-bold theme-accent-color flex-shrink-0"><%= count %> book<%= count == 1 ? '' : 's' %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="theme-text-muted text-sm">No books yet.</p>
      <% end %>
    </div>

    <!-- Status Breakdown -->
    <div class="theme-bg-card rounded-xl shadow-lg p-6 border theme-border">
      <h2 class="text-lg font-bold theme-text mb-4">By Status</h2>
      <% total = @status_breakdown.values.sum.to_f %>
      <div class="space-y-3">
        <% @status_breakdown.each do |status, count| %>
          <% pct = total > 0 ? (count / total * 100).round : 0 %>
          <div>
            <div class="flex justify-between text-sm mb-1">
              <span class="theme-text-secondary"><%= status %></span>
              <span class="theme-text font-semibold"><%= count %></span>
            </div>
            <div class="w-full rounded-full h-2" style="background-color: var(--theme-border);">
              <div class="theme-progress-bar h-2 rounded-full" style="width: <%= pct %>%;"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Top Tropes -->
    <div class="theme-bg-card rounded-xl shadow-lg p-6 border theme-border">
      <h2 class="text-lg font-bold theme-text mb-4">Top Tropes</h2>
      <% if @top_tropes.any? %>
        <div class="space-y-3">
          <% max_trope_count = @top_tropes.values.max.to_f %>
          <% @top_tropes.each do |trope_name, count| %>
            <% pct = max_trope_count > 0 ? (count / max_trope_count * 100).round : 0 %>
            <div>
              <div class="flex justify-between text-sm mb-1">
                <span class="theme-text-secondary truncate pr-2"><%= trope_name %></span>
                <span class="theme-text font-semibold flex-shrink-0"><%= count %></span>
              </div>
              <div class="w-full rounded-full h-2" style="background-color: var(--theme-border);">
                <div class="theme-progress-bar h-2 rounded-full" style="width: <%= pct %>%;"></div>
              </div>
            </div>
          <% end %>
        </div>
        <% if @avg_spice %>
          <div class="mt-4 pt-4 border-t theme-border">
            <p class="text-xs theme-text-muted mb-0.5">Your avg spice level</p>
            <p class="text-2xl font-black" style="color: var(--theme-accent);">
              <%= '🌶️' * @avg_spice.round %> <span class="text-base font-semibold theme-text-secondary">(<%= @avg_spice %>/5)</span>
            </p>
          </div>
        <% end %>
      <% else %>
        <p class="theme-text-muted text-sm">Tag some books with tropes to see your top picks.</p>
      <% end %>
    </div>

    <!-- Rating Distribution -->
    <div class="theme-bg-card rounded-xl shadow-lg p-6 border theme-border">
      <h2 class="text-lg font-bold theme-text mb-1">Ratings</h2>
      <% if @avg_rating %>
        <p class="text-3xl font-black theme-star mb-4"><%= @avg_rating %> ★</p>
      <% end %>
      <% max_rating_count = @rating_breakdown.map { |_, c| c }.max.to_f %>
      <div class="space-y-2">
        <% (5).downto(1) do |star| %>
          <% count = @rating_breakdown.to_h[star] || 0 %>
          <% pct   = max_rating_count > 0 ? (count / max_rating_count * 100).round : 0 %>
          <div class="flex items-center gap-2">
            <span class="text-xs theme-star w-4 text-right"><%= star %>★</span>
            <div class="flex-1 rounded-full h-2" style="background-color: var(--theme-border);">
              <div class="theme-progress-bar h-2 rounded-full" style="width: <%= pct %>%;"></div>
            </div>
            <span class="text-xs theme-text-muted w-4"><%= count %></span>
          </div>
        <% end %>
      </div>
      <% if @rating_breakdown.empty? %>
        <p class="theme-text-muted text-sm mt-2">Rate some books to see your distribution.</p>
      <% end %>
    </div>
  </div>
</div>

<script type="module">
  import { Chart, BarController, LineController, BarElement, LineElement, PointElement,
           CategoryScale, LinearScale, Tooltip, Filler } from 'chart.js';

  Chart.register(BarController, LineController, BarElement, LineElement, PointElement,
                 CategoryScale, LinearScale, Tooltip, Filler);

  const accent  = getComputedStyle(document.documentElement).getPropertyValue('--theme-accent').trim();
  const border  = getComputedStyle(document.documentElement).getPropertyValue('--theme-border').trim();
  const textCol = getComputedStyle(document.documentElement).getPropertyValue('--theme-text-secondary').trim();

  const labels = <%= raw @monthly_data.map { |d| d[:label] }.to_json %>;
  const books  = <%= raw @monthly_data.map { |d| d[:books] }.to_json %>;
  const pages  = <%= raw @monthly_data.map { |d| d[:pages] }.to_json %>;

  const sharedOptions = {
    responsive: true,
    plugins: { legend: { display: false }, tooltip: { callbacks: { labelColor: () => ({ backgroundColor: accent }) } } },
    scales: {
      x: { ticks: { color: textCol, font: { size: 11 } }, grid: { color: border } },
      y: { ticks: { color: textCol, font: { size: 11 } }, grid: { color: border }, beginAtZero: true }
    }
  };

  new Chart(document.getElementById('booksChart'), {
    type: 'bar',
    data: { labels, datasets: [{ data: books, backgroundColor: accent + 'CC', borderRadius: 6 }] },
    options: sharedOptions
  });

  new Chart(document.getElementById('pagesChart'), {
    type: 'line',
    data: { labels, datasets: [{ data: pages, borderColor: accent, backgroundColor: accent + '22',
            fill: true, tension: 0.4, pointBackgroundColor: accent, pointRadius: 4 }] },
    options: sharedOptions
  });
</script>
