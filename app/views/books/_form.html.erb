<%= form_with(model: book, class: "max-w-2xl mx-auto") do |form| %>
  <% if book.errors.any? %>
    <div class="rounded-lg px-4 py-3 mb-6 border theme-border"
         style="background-color: var(--theme-bg-card); color: var(--theme-stat-finished);">
      <h2 class="font-semibold mb-2"><%= pluralize(book.errors.count, "error") %> prohibited this book from being saved:</h2>
      <ul class="list-disc list-inside theme-text-secondary">
        <% book.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-6">
    <%= form.label :title, class: "block text-sm font-medium theme-text-secondary mb-2" %>
    <%= form.text_field :title,
        class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
        style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
  </div>

  <div class="mb-6">
    <%= form.label :author, class: "block text-sm font-medium theme-text-secondary mb-2" %>
    <%= form.text_field :author,
        class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
        style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
  </div>

  <div class="mb-6">
    <%= form.label :format, class: "block text-sm font-medium theme-text-secondary mb-2" %>
    <%= form.select :format, Book::FORMATS, { prompt: 'Select a format' },
        class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
        style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
  </div>

  <% custom_genre = book.genre.present? && !Book::GENRES.include?(book.genre) %>
  <div class="mb-6">
    <%= form.label :genre, class: "block text-sm font-medium theme-text-secondary mb-2" %>
    <%= form.select :genre,
        Book::GENRES.map { |g| [g, g] },
        { prompt: 'Select a genre', selected: custom_genre ? 'Other' : book.genre },
        class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
        style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);",
        id: "genre_select_edit",
        disabled: custom_genre,
        onchange: "toggleCustomGenre(this, 'custom_genre_edit')" %>
    <input type="text"
           id="custom_genre_edit"
           name="book[genre]"
           placeholder="Enter your genre…"
           value="<%= custom_genre ? book.genre : '' %>"
           <%= custom_genre ? '' : 'disabled' %>
           class="w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border mt-2"
           style="background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary); display: <%= custom_genre ? 'block' : 'none' %>;">
  </div>

  <div class="mb-6">
    <%= form.label :pages, class: "block text-sm font-medium theme-text-secondary mb-2" %>
    <%= form.number_field :pages,
        class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
        style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
  </div>

  <div class="mb-6">
    <%= form.label :status, class: "block text-sm font-medium theme-text-secondary mb-2" %>
    <%= form.select :status, Book::STATUSES, { prompt: 'Select a status' },
        class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
        style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
  </div>

  <div class="grid grid-cols-2 gap-4 mb-8">
    <div>
      <%= form.label :started_at, "Date Started", class: "block text-sm font-medium theme-text-secondary mb-2" %>
      <%= form.date_field :started_at,
          value: book.started_at&.to_date,
          class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
          style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
    </div>
    <div>
      <%= form.label :finished_at, "Date Finished", class: "block text-sm font-medium theme-text-secondary mb-2" %>
      <%= form.date_field :finished_at,
          value: book.finished_at&.to_date,
          class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
          style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
    </div>
  </div>

  <div class="mb-6">
    <%= form.label :cover_url, "Book Cover URL (optional)", class: "block text-sm font-medium theme-text-secondary mb-2" %>
    <%= form.text_field :cover_url, placeholder: "https://...",
        class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
        style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
  </div>

  <div class="mb-6">
    <p class="block text-sm font-medium theme-text-secondary mb-3">Tropes <span class="theme-text-muted font-normal">(select all that apply)</span></p>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-2 p-4 rounded-lg border theme-border"
         style="background-color: var(--theme-input-bg);">
      <% @tropes.each do |trope| %>
        <label class="flex items-center gap-2 cursor-pointer group">
          <%= check_box_tag 'book[trope_ids][]', trope.id,
              book.trope_ids.include?(trope.id),
              id: "trope_#{trope.id}",
              class: "rounded cursor-pointer",
              style: "accent-color: var(--theme-accent);" %>
          <span class="text-sm theme-text group-hover:opacity-80 transition"><%= trope.name %></span>
        </label>
      <% end %>
    </div>
    <%# Hidden field ensures empty array is submitted when no tropes are checked %>
    <%= hidden_field_tag 'book[trope_ids][]', '' %>
  </div>

  <div class="mt-8">
    <%= form.submit class: "w-full font-medium py-3 px-6 rounded-lg cursor-pointer transition duration-200 hover:opacity-80",
        style: "background-color: var(--theme-accent); color: var(--theme-accent-text);" %>
  </div>
<% end %>
