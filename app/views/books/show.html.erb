<div class="max-w-5xl mx-auto">
  <div class="mb-6 flex items-center justify-between">
    <%= link_to "← Back to Books", books_path, class: "theme-text-muted hover:opacity-70 transition text-sm" %>
    <div class="flex gap-3">
      <%= link_to "Edit", edit_book_path(@book),
          class: "px-4 py-1.5 rounded-lg transition text-sm border theme-border theme-text hover:opacity-70",
          style: "background-color: var(--theme-bg);" %>
      <%= button_to "Delete", @book, method: :delete,
          data: { turbo_confirm: "Are you sure?" },
          class: "px-4 py-1.5 rounded-lg transition text-sm cursor-pointer",
          style: "background-color: #991111; color: #fff; border: none;" %>
    </div>
  </div>

  <% if notice %>
    <p class="rounded-lg px-4 py-3 mb-6 text-sm border theme-border theme-text-secondary"
       style="background-color: var(--theme-bg-card);"><%= notice %></p>
  <% end %>

  <%# ── Book Review Card ─────────────────────────────────────── %>
  <div class="theme-bg-card rounded-2xl shadow-xl border theme-border overflow-hidden">

    <%# Header banner %>
    <div class="px-8 py-5 border-b theme-border">
      <h1 class="text-2xl font-bold theme-text tracking-wide">Book Review</h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-5 gap-0">

      <%# ── Left column: book info + notes ── %>
      <div class="md:col-span-3 p-8 border-r theme-border space-y-5">

        <%# Title %>
        <div class="rounded-xl px-4 py-3 border theme-border" style="background-color: var(--theme-bg);">
          <p class="text-xs theme-text-muted mb-0.5">Title</p>
          <p class="font-semibold theme-text"><%= @book.title %></p>
        </div>

        <%# Author %>
        <div class="rounded-xl px-4 py-3 border theme-border" style="background-color: var(--theme-bg);">
          <p class="text-xs theme-text-muted mb-0.5">Author</p>
          <p class="font-semibold theme-text"><%= @book.author.presence || '—' %></p>
        </div>

        <%# Genre %>
        <div class="rounded-xl px-4 py-3 border theme-border" style="background-color: var(--theme-bg);">
          <p class="text-xs theme-text-muted mb-0.5">Genre</p>
          <p class="font-semibold theme-text"><%= @book.genre.presence || '—' %></p>
        </div>

        <%# Format %>
        <div class="rounded-xl px-4 py-3 border theme-border" style="background-color: var(--theme-bg);">
          <p class="text-xs theme-text-muted mb-2">Format</p>
          <div class="flex gap-2">
            <% [['Physical', '📖'], ['Audiobook', '🎧'], ['E-Reader', '📱']].each do |label, icon| %>
              <%= button_to book_path(@book, book: { format: label }), method: :patch,
                  class: "flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm transition cursor-pointer hover:opacity-80",
                  style: "border: 1px solid #{@book.format == label ? 'var(--theme-accent)' : 'var(--theme-border)'}; background-color: #{@book.format == label ? 'color-mix(in srgb, var(--theme-accent) 15%, var(--theme-bg))' : 'transparent'}; color: var(--theme-text-#{@book.format == label ? 'primary' : 'muted'});" do %>
                <span><%= icon %></span>
                <span><%= label %></span>
              <% end %>
            <% end %>
          </div>
        </div>

        <%# Tropes %>
        <div class="rounded-xl px-4 py-3 border theme-border" style="background-color: var(--theme-bg);">
          <p class="text-xs theme-text-muted mb-2">Tropes</p>
          <% if @book.tropes.any? %>
            <div class="flex flex-wrap gap-1.5">
              <% @book.tropes.order(:name).each do |trope| %>
                <span class="text-xs px-2.5 py-1 rounded-full border theme-border theme-text-secondary"
                      style="background-color: color-mix(in srgb, var(--theme-accent) 12%, var(--theme-bg));">
                  <%= trope.name %>
                </span>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm theme-text-muted">No tropes tagged yet.</p>
          <% end %>
        </div>

        <%# Your Review %>
        <div class="rounded-xl border theme-border overflow-hidden" style="background-color: var(--theme-bg);">
          <p class="text-xs theme-text-muted px-4 pt-3 pb-2 border-b theme-border font-medium">Your Review</p>
          <% if @review.persisted? %>
            <div class="px-4 py-3 space-y-2">
              <% if @review.rating.present? %>
                <p class="text-sm theme-text"><span class="theme-text-muted text-xs">Rating:</span> <%= '★' * @review.rating.to_i %></p>
              <% end %>
              <% if @review.spice_level.present? %>
                <p class="text-sm theme-text"><span class="theme-text-muted text-xs">Spice:</span> <%= '🌶️' * @review.spice_level %></p>
              <% end %>
              <% if @review.review_text.present? %>
                <p class="text-sm theme-text"><%= @review.review_text %></p>
              <% end %>
              <div class="flex gap-3 pt-1">
                <%= link_to 'Edit review', edit_book_review_path(@book),
                    class: "text-xs theme-accent-color hover:opacity-70 transition" %>
                <%= button_to 'Remove', book_review_path(@book), method: :delete,
                    data: { turbo_confirm: 'Remove your review?' },
                    class: "text-xs cursor-pointer hover:opacity-70 transition",
                    style: "color: #991111; background: none; border: none;" %>
              </div>
            </div>
          <% else %>
            <%= form_with(model: [@book, @review], url: book_review_path(@book)) do |form| %>
              <div class="px-4 py-3 space-y-3">
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <%= form.label :rating, 'Your rating (1–5)', class: "block text-xs theme-text-muted mb-1" %>
                    <%= form.number_field :rating, min: 1, max: 5, step: 0.5,
                        placeholder: '—',
                        class: "w-full px-3 py-1.5 rounded-lg border theme-border text-sm outline-none",
                        style: "background-color: var(--theme-input-bg); color: var(--theme-text-primary);" %>
                  </div>
                  <div>
                    <%= form.label :spice_level, 'Spice (1–5)', class: "block text-xs theme-text-muted mb-1" %>
                    <%= form.number_field :spice_level, min: 1, max: 5,
                        placeholder: '—',
                        class: "w-full px-3 py-1.5 rounded-lg border theme-border text-sm outline-none",
                        style: "background-color: var(--theme-input-bg); color: var(--theme-text-primary);" %>
                  </div>
                </div>
                <%= form.text_area :review_text, rows: 4,
                    placeholder: 'Write your recap or thoughts…',
                    class: "w-full px-3 py-2 rounded-lg border theme-border text-sm outline-none resize-none",
                    style: "background-color: var(--theme-input-bg); color: var(--theme-text-primary);" %>
                <%= form.submit 'Save Review',
                    class: "w-full py-2 text-sm font-medium cursor-pointer transition hover:opacity-80 rounded-lg",
                    style: "background-color: var(--theme-accent); color: var(--theme-accent-text); border: none;" %>
              </div>
            <% end %>
          <% end %>
        </div>

        <%# Notes / Reflections %>
        <div class="rounded-xl border theme-border overflow-hidden" style="background-color: var(--theme-bg);">
          <p class="text-xs theme-text-muted px-4 pt-3 pb-2 border-b theme-border font-medium">Notes</p>

          <%# Add reflection form %>
          <%= form_with(model: [@book, @book.reflections.build]) do |form| %>
            <%= form.text_area :content, rows: 5,
                placeholder: "Write your thoughts…",
                class: "w-full px-4 py-3 outline-none resize-none text-sm border-b theme-border",
                style: "background: transparent; color: var(--theme-text-primary);" %>
            <%= form.submit "Save Note",
                class: "w-full py-2 text-sm font-medium cursor-pointer transition hover:opacity-80",
                style: "background-color: var(--theme-accent); color: var(--theme-accent-text); border: none;" %>
          <% end %>

          <%# Previous reflections %>
          <% if @book.reflections.any? %>
            <div class="divide-y" style="border-color: var(--theme-border);">
              <% @book.reflections.order(created_at: :desc).each do |reflection| %>
                <div class="px-4 py-3 flex justify-between items-start gap-3">
                  <div class="min-w-0">
                    <p class="text-xs theme-text-muted mb-1"><%= reflection.created_at.strftime("%b %-d, %Y") %></p>
                    <p class="text-sm theme-text"><%= reflection.content %></p>
                  </div>
                  <%= button_to book_reflection_path(@book, reflection), method: :delete,
                      data: { turbo_confirm: "Delete this note?" },
                      class: "text-xs flex-shrink-0 hover:opacity-70 transition cursor-pointer",
                      style: "color: #991111; background: none; border: none;" do %>✕<% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

      </div>

      <%# ── Right column: cover + ratings ── %>
      <div class="md:col-span-2 p-8 space-y-5">

        <%# Cover %>
        <div class="rounded-xl border theme-border overflow-hidden flex items-center justify-center"
             style="background-color: var(--theme-bg); min-height: 260px;">
          <% if @book.cover_url.present? %>
            <%= image_tag @book.cover_url,
                class: "w-full object-cover",
                style: "max-height: 320px; object-fit: cover;",
                alt: @book.title %>
          <% else %>
            <span class="theme-text-muted text-sm">No cover</span>
          <% end %>
        </div>

        <%# Rating rows %>
        <% ratings = [
             { label: 'Star Rating',     field: :rating,          icons: ['★', '★', '★', '★', '★'],          color: 'var(--theme-star)' },
             { label: 'Spice Rating',    field: :spice_rating,    icons: ['🌶️', '🌶️', '🌶️', '🌶️', '🌶️'],   color: nil },
             { label: 'Sadness Rating',  field: :sadness_rating,  icons: ['💧', '💧', '💧', '💧', '💧'],      color: nil },
             { label: 'Humor Rating',    field: :humor_rating,    icons: ['😊', '😊', '😊', '😊', '😊'],      color: nil },
             { label: 'Suspense Rating', field: :suspense_rating, icons: ['⚠️', '⚠️', '⚠️', '⚠️', '⚠️'],   color: nil },
           ] %>

        <% ratings.each do |r| %>
          <div class="rounded-xl px-4 py-3 border theme-border" style="background-color: var(--theme-bg);">
            <p class="text-xs theme-text-muted mb-2"><%= r[:label] %></p>
            <div class="flex gap-1" id="rating-<%= r[:field] %>">
              <% current_val = @book.send(r[:field]).to_i %>
              <% (1..5).each do |n| %>
                <%= button_to book_path(@book, book: { r[:field] => n }), method: :patch,
                    class: "rating-btn text-xl transition hover:scale-110 cursor-pointer",
                    style: "background: none; border: none; padding: 2px;
                            opacity: #{current_val >= n ? '1' : '0.25'};",
                    data: { field: r[:field], value: n } do %>
                  <%= r[:icons][n - 1] %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

      </div>
    </div>
  </div>
</div>
