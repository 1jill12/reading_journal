<div class="max-w-7xl mx-auto">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold theme-text">My Reading Journey</h1>
    <%= link_to "Add New Book", new_book_path,
        class: "font-medium py-3 px-6 rounded-lg transition duration-200 hover:opacity-80",
        style: "background-color: var(--theme-accent); color: var(--theme-accent-text);" %>
  </div>

  <% if notice %>
    <p class="rounded-lg px-4 py-3 mb-6 text-sm border theme-border theme-text-secondary"
       style="background-color: var(--theme-bg-card);">
      <%= notice %>
    </p>
  <% end %>

  <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-6">
    <% @books.each do |book| %>
      <%= link_to book, class: "block group" do %>
        <div class="relative">
          <% if book.cover_url.present? %>
            <%= image_tag book.cover_url,
                class: "w-full h-64 object-cover rounded-lg shadow-md group-hover:shadow-xl transition duration-200",
                alt: book.title %>
          <% else %>
            <div class="w-full h-64 rounded-lg flex items-center justify-center shadow-md"
                 style="background-color: var(--theme-bg-card); border: 1px solid var(--theme-border);">
              <span class="theme-text-muted text-sm text-center px-2"><%= book.title %></span>
            </div>
          <% end %>
          <div class="absolute bottom-0 left-0 right-0 p-2 rounded-b-lg opacity-0 group-hover:opacity-100 transition duration-200"
               style="background-color: rgba(0,0,0,0.75);">
            <p class="text-sm font-semibold text-white truncate"><%= book.title %></p>
            <p class="text-xs text-gray-300 truncate"><%= book.author %></p>
            <p class="text-xs text-gray-400 mt-1"><%= book.status %></p>
            <% if book.rating %>
              <p class="text-xs mt-1 theme-star">★ <%= book.rating %></p>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
