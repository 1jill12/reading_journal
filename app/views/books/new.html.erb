<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <%= link_to "← Back to books", books_path, class: "theme-text-muted hover:opacity-70 transition" %>
  </div>

  <h1 class="text-4xl font-bold theme-text mb-8">Add New Book</h1>

  <%# Live book search %>
  <div class="mb-8" data-controller="book-search">

    <%# Search input %>
    <div class="relative">
      <label class="block text-sm font-medium theme-text-secondary mb-2">Search for a book</label>
      <input type="text"
             data-book-search-target="input"
             data-action="input->book-search#search focusout->book-search#close"
             placeholder="Type a title or author…"
             autocomplete="off"
             class="w-full px-4 py-3 rounded-lg border outline-none focus:ring-2 text-base"
             style="background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);">

      <%# Dropdown results %>
      <div data-book-search-target="results"
           class="hidden absolute z-20 w-full rounded-lg shadow-xl border overflow-hidden mt-1"
           style="background-color: var(--theme-nav-bg); border-color: var(--theme-border);">
      </div>
    </div>

    <%# Cover preview %>
    <div class="mt-4 flex items-start gap-4">
      <img data-book-search-target="coverPreview"
           src="" alt="Cover preview"
           class="hidden w-20 rounded shadow-md object-cover">
      <p class="text-xs theme-text-muted mt-1">Select a result above to fill in the details, or fill in the form below manually.</p>
    </div>

    <%# Hidden form with targets — rendered by _form partial below but we need targets here too %>
    <%# The actual inputs are in the form below; we wire them up via targets %>

    <div class="mt-6 theme-bg-card rounded-xl border theme-border p-6 shadow-lg">
      <%= form_with(model: @book, class: "space-y-5") do |form| %>
        <% if @book.errors.any? %>
          <div class="rounded-lg px-4 py-3 border theme-border"
               style="background-color: var(--theme-bg-card); color: var(--theme-stat-finished);">
            <ul class="list-disc list-inside theme-text-secondary text-sm">
              <% @book.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label :title, class: "block text-sm font-medium theme-text-secondary mb-1" %>
          <%= form.text_field :title,
              data: { "book-search-target": "title" },
              class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
              style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
        </div>

        <div>
          <%= form.label :author, class: "block text-sm font-medium theme-text-secondary mb-1" %>
          <%= form.text_field :author,
              data: { "book-search-target": "author" },
              class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
              style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
        </div>

        <div>
          <%= form.label :format, class: "block text-sm font-medium theme-text-secondary mb-1" %>
          <%= form.select :format, Book::FORMATS, { prompt: 'Select a format' },
              class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
              style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
        </div>

        <div>
          <%= form.label :genre, class: "block text-sm font-medium theme-text-secondary mb-1" %>
          <%= form.select :genre, Book::GENRES, { prompt: 'Select a genre' },
              data: { "book-search-target": "genre" },
              class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
              style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);",
              id: "genre_select_new",
              onchange: "toggleCustomGenre(this, 'custom_genre_new')" %>
          <input type="text"
                 id="custom_genre_new"
                 name="book[genre]"
                 placeholder="Enter your genre…"
                 disabled
                 class="w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border mt-2"
                 style="background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary); display: none;">
        </div>

        <div>
          <%= form.label :pages, class: "block text-sm font-medium theme-text-secondary mb-1" %>
          <%= form.number_field :pages,
              data: { "book-search-target": "pages" },
              class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
              style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
        </div>

        <div>
          <%= form.label :status, class: "block text-sm font-medium theme-text-secondary mb-1" %>
          <%= form.select :status, Book::STATUSES, { prompt: 'Select a status' },
              class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
              style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :started_at, "Date Started", class: "block text-sm font-medium theme-text-secondary mb-1" %>
            <%= form.date_field :started_at,
                class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
                style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
          </div>
          <div>
            <%= form.label :finished_at, "Date Finished", class: "block text-sm font-medium theme-text-secondary mb-1" %>
            <%= form.date_field :finished_at,
                class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
                style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
          </div>
        </div>

        <div>
          <%= form.label :cover_url, "Book Cover URL (optional)", class: "block text-sm font-medium theme-text-secondary mb-1" %>
          <%= form.text_field :cover_url,
              data: { "book-search-target": "coverUrl" },
              placeholder: "https://…",
              class: "w-full px-4 py-2 rounded-lg outline-none focus:ring-2 border",
              style: "background-color: var(--theme-input-bg); border-color: var(--theme-input-border); color: var(--theme-text-primary);" %>
        </div>

        <div>
          <p class="block text-sm font-medium theme-text-secondary mb-2">Tropes <span class="theme-text-muted font-normal">(select all that apply)</span></p>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-2 p-4 rounded-lg border theme-border"
               style="background-color: var(--theme-input-bg);">
            <% Book::TROPES.each do |trope| %>
              <label class="flex items-center gap-2 cursor-pointer group">
                <%= check_box_tag "book[tropes][]", trope, false,
                    id: "trope_#{trope.parameterize}",
                    class: "rounded cursor-pointer",
                    style: "accent-color: var(--theme-accent);" %>
                <span class="text-sm theme-text group-hover:opacity-80 transition"><%= trope %></span>
              </label>
            <% end %>
          </div>
          <%= hidden_field_tag "book[tropes][]", "" %>
        </div>

        <div class="pt-2">
          <%= form.submit "Add Book",
              class: "w-full font-medium py-3 px-6 rounded-lg cursor-pointer transition duration-200 hover:opacity-80",
              style: "background-color: var(--theme-accent); color: var(--theme-accent-text);" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
